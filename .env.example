# MongoDB Database Configuration
MONGODB_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DATABASE_NAME="your_database_name"

# MongoDB Collection Names (Optional custom overrides)
EVENTS_COLLECTION="your_events_collection"
EVENT_REGISTRATIONS_COLLECTION="your_event_registrations_collection"
REGISTRATIONS_COLLECTION="your_registrations_collection"
EMAIL_LOGS_COLLECTION="your_email_logs_collection"
ACTIVITIES_COLLECTION="your_activities_collection"
CORE_TEAM_COLLECTION="your_core_team_collection"
ADMIN_COLLECTION="your_admin_collection"

# NextAuth v5 Configuration
AUTH_SECRET="your-32-character-secret-generate-with-openssl-rand-base64-32"
ADMIN_TOKEN="your-admin-bootstrap-token"

# Amazon SES Email Configuration
AWS_REGION="your_aws_region"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_SES_FROM_EMAIL="COOU Techies <team@yourdomain.org>"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Public Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_CHANNEL="https://whatsapp.com/channel/your-channel-id"
